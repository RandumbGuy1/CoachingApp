{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "start-client",
      "postDebugTask": "stop-client",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/api/CoachApi.csproj"
      ],
      "cwd": "${workspaceFolder}/api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ],
}